<?xml version="1.0" encoding="UTF-8"?>
<pluginMetaData path="thread-viewer">
    <name>Thread Viewer</name>
    <author>Chris Gibson</author>
    <pluginVersion>${project.version}</pluginVersion>
    <mirthVersion>${plugin.supported.oie.versions}</mirthVersion>
    <url></url>
    <description>Real-time JVM thread monitoring with channel-aware filtering, state analysis, blocked thread detection, and stack trace inspection.</description>

    <serverClasses>
        <pluginClass>
            <name>com.mirth.connect.plugins.threadviewer.server.ThreadViewerServerPlugin</name>
        </pluginClass>
    </serverClasses>

    <clientClasses>
        <pluginClass>
            <name>com.mirth.connect.plugins.threadviewer.client.ThreadViewerClientPlugin</name>
        </pluginClass>
    </clientClasses>

    <apiProvider type="SERVLET_INTERFACE" name="com.mirth.connect.plugins.threadviewer.shared.ThreadViewerServletInterface" />
    <apiProvider type="SERVER_CLASS" name="com.mirth.connect.plugins.threadviewer.server.servlet.ThreadViewerServlet" />

    <!-- Module JARs -->
    <library type="SHARED" path="libs/thread-viewer-shared-${project.version}.jar" />
    <library type="SERVER" path="libs/thread-viewer-server-${project.version}.jar" />
    <library type="CLIENT" path="libs/thread-viewer-client-${project.version}.jar" />
</pluginMetaData>
